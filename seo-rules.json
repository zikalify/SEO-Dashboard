{
  "version": "2026.10.07-r5",
  "updated": "2026-10-07",
  "notes": "SEO thresholds for article drafts, re-audited 2026-10-07 against Google's own documentation. Two principles drive the numbers. (1) Search-result truncation is a PIXEL-WIDTH constraint on the device, not a character count -- there is no character limit on <title> or <meta description>, Google rewrites both, and what survives is an estimate (~55-60 chars desktop, ~120-155 chars description). (2) There is no ranking factor for word count, keyword density, Flesch, emoji or CTA phrasing, so none of those are scored as hard failures; they are reported as craft advice. Structural checks (headings, internal/external links) are gated behind minWordsForStructure, because a 200-word news brief genuinely does not need subheadings and telling writers to add them is the single biggest source of clutter. minWordsForList / ForFaq / ForConclusion are deliberately high: those are format suggestions, not correctness, and only pay off in pieces long enough to have a format. sectionLevel 3 matches the Neowin CMS (H3 section headers) -- set it to 2 for a standard H2 site and all checks, suggestions and templates follow automatically. Tune any value and redeploy; the app follows this file.",
  "sources": [
    "https://developers.google.com/search/docs/fundamentals/seo-starter-guide",
    "https://developers.google.com/search/docs/fundamentals/creating-helpful-content",
    "https://developers.google.com/search/docs/appearance/title-link",
    "https://developers.google.com/search/docs/appearance/snippet",
    "https://developers.google.com/search/docs/appearance/google-images",
    "https://developers.google.com/search/docs/appearance/structured-data/faqpage",
    "https://developers.google.com/search/blog/2023/08/howto-faq-changes",
    "https://developers.google.com/search/blog/2021/08/update-to-generating-page-titles"
  ],
  "rules": {
    "title": {
      "minChars": 40,
      "maxChars": 60,
      "hardMaxChars": 70,
      "rewriteSafeMin": 51,
      "rewriteSafeMax": 55,
      "keywordAtStartMaxPos": 15,
      "warnEmojiMax": 0
    },
    "summary": {
      "label": "Article summary (used as meta description)",
      "minChars": 120,
      "maxChars": 155,
      "hardMaxChars": 170
    },
    "excerpt": {
      "label": "Excerpt (listing / teaser snippet)",
      "minChars": 80,
      "maxChars": 160,
      "hardMaxChars": 200
    },
    "body": {
      "minWords": 300,
      "goodWords": 1000,
      "minWordsForStructure": 300,
      "minParagraphs": 3,
      "maxSentenceWords": 25,
      "longSentenceShareWarn": 0.25,
      "maxParagraphWords": 120,
      "keywordDensityMin": 0.005,
      "keywordDensityMax": 0.025,
      "keywordDensityGoodMax": 0.02,
      "firstKeywordWithinWords": 100,
      "sectionLevel": 3,
      "minSections": 1,
      "wordsPerSection": 350,
      "siteDomain": "neowin.net",
      "minInternalLinks": 1,
      "minExternalLinks": 1,
      "transitionWordsMinShare": 0.2,
      "passiveVoiceMaxShare": 0.15,
      "minWordsForList": 600,
      "minWordsForFaq": 1200,
      "minWordsForConclusion": 800
    },
    "readability": {
      "fleschGood": 60,
      "fleschOkay": 40
    }
  },
